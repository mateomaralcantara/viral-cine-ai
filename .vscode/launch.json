{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ViralCine V8 — Abrir localhost:3010",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": [
        "dev",
        "--webpack",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3010"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "-?\\s*Local:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
