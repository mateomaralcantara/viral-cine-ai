{
  "name": "viralcine-studio-pro",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Estudio privado de producción audiovisual larga con pipeline audio-first, voces persistentes, video IA real, lip-sync y montaje FFmpeg.",
  "scripts": {
    "dev": "next dev --webpack",
    "worker": "node --import tsx scripts/worker.ts",
    "studio": "concurrently -n WEB,WORKER -c cyan,magenta \"next dev --webpack\" \"node --import tsx scripts/worker.ts\"",
    "build": "next build",
    "start": "next start",
    "studio:prod": "concurrently -n WEB,WORKER -c cyan,magenta \"next start\" \"node --import tsx scripts/worker.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx scripts/smoke-pipeline.ts",
    "check:env": "node scripts/check-env.mjs",
    "migrate:4": "node --import tsx scripts/migrate-v4.ts",
    "voices:4": "node --import tsx scripts/voices-v4.ts",
    "casting:4": "node --import tsx scripts/casting-v4.ts",
    "verify:4": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@google/genai": "^2.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "openai": "^6.15.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
