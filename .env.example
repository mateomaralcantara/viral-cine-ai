# ViralCine 4.0 Real Cinema
# demo/offline genera video sintetico en movimiento y nunca consume APIs.
# real habilita guion, referencias, voz, video, lip-sync y musica por IA.
PRODUCTION_MODE=demo
REQUIRE_REAL_MEDIA=false
REAL_CINEMA_PIPELINE=true
REAL_CINEMA_NATIVE_AUDIO=false

# Cortacircuito obligatorio. Ambos deben cambiarse conscientemente a true para
# que cualquier proveedor externo o pagado pueda recibir una solicitud.
ALLOW_EXTERNAL_API_CALLS=false
ALLOW_PAID_GENERATION=false
ALLOW_PAID_PROVIDER_FALLBACK=false
AUTO_REGENERATE=false

# Piloto obligatorio por defecto. Mientras sea true no se produce la pelicula completa.
PILOT_MODE=true
PILOT_MAX_SCENES=1
PILOT_MAX_SHOTS=4
PILOT_MAX_SPEND_USD=1.00

# Proteccion opcional con autenticacion basica. Recomendada si se publica.
STUDIO_ACCESS_KEY=

# Carpeta de proyectos. En Windows puedes usar C:\ViralCineData
VIRALCINE_DATA_DIR=.data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# OpenAI: guion estructurado, personajes, imagenes y auditoria.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# ElevenLabs: una voz persistente por personaje. No uses voces clonadas sin autorizacion.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.25
ELEVENLABS_SPEED=1.00

# Puerta de calidad por segmento: off | strict
SCENE_QUALITY_MODE=strict
# critical-only continua automaticamente con defectos menores y pausa unicamente
# ante un fallo grave. strict conserva la aprobacion manual para toda nota baja.
SCENE_QUALITY_POLICY=critical-only
OPENAI_QUALITY_MODEL=gpt-5.6
SCENE_QUALITY_MIN_SCORE=8.0
# Una sola generacion. Una nota baja no provoca otra llamada de video.
SCENE_QUALITY_MAX_ATTEMPTS=1

# Video real interno por segmentos invisibles de 4-8 s.
# Valores: auto | omni | veo | fal | wan
VIDEO_PROVIDER=veo
REQUIRE_VIDEO_ONLY=true
ALLOW_FAL_AVATAR_FALLBACK=false
FAL_AVATAR_ONLY_SINGLE_SUBJECT=true
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_OMNI_VIDEO_MODEL=gemini-omni-flash-preview
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p

# Alibaba Cloud Model Studio / DashScope: Wan 2.6 I2V Flash.
# Para International/Singapore el endpoint legacy sigue operativo.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
WAN_VIDEO_MODEL=wan2.6-i2v-flash

# Fal.ai: video alternativo, lip-sync, musica y compatibilidad legado.
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/vidu/q3/image-to-video
FAL_AVATAR_MODEL=fal-ai/longcat-single-avatar/image-audio-to-video
FAL_MUSIC_MODEL=cassetteai/music-generator
ENABLE_LIPSYNC=true
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v3
FAL_LIPSYNC_SYNC_MODE=cut_off

# Costos preventivos editables (USD). No sustituyen la factura real del proveedor.
COST_SCRIPT_CALL=0.08
COST_AI_VIDEO_SECOND=0.10
# Compatibilidad con instalaciones 2.x; se usa solo si falta COST_AI_VIDEO_SECOND.
COST_AI_VIDEO_8S=1.23
COST_AVATAR_SECOND=0.30
COST_IMAGE=0.08
COST_TTS_1K_CHARS=0.015
COST_LIPSYNC_SECOND=0.014
COST_MUSIC_SECOND=0.003
COST_QUALITY_REVIEW=0.03

# Cortafuegos de gasto. Cada llamada de video se reserva antes de enviarse.
SHOT_MAX_TOTAL_GENERATIONS=1
MAX_SHOT_SPEND_USD=2
MAX_MOVIE_SPEND_USD=12

# No reutilizar checkpoints antiguos que podrian venir de demo o de video invalido
# durante produccion real. La migracion 4.0 nunca borra esos archivos.
ALLOW_LEGACY_CHECKPOINTS=false

# Rechazar negro, congelado o dialogo inaudible antes de la auditoria de calidad.
BLACK_FRAME_MAX_RATIO=0.35
FREEZE_FRAME_MAX_RATIO=0.60
MIN_DIALOGUE_MEAN_DB=-48

# Maximo de segmentos generativos costosos al mismo tiempo.
PRODUCTION_CONCURRENCY=1

# Simulacion de fallos para pruebas offline futuras.
# success | 429 | network-timeout | accepted-then-timeout | missing-file | corrupt-file | crash-after-save | worker-restart
FAKE_PROVIDER_SCENARIO=success
FAKE_PROVIDER_STAGE=
