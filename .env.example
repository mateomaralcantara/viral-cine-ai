# demo genera un MP4 real con placas animadas y silencio, sin gastar APIs.
# real habilita guion, imágenes, voz, video, avatares y música por IA.
PRODUCTION_MODE=demo
REQUIRE_REAL_MEDIA=false

# Cortacircuito obligatorio. Ambos deben cambiarse conscientemente a true para
# que cualquier proveedor externo o pagado pueda recibir una solicitud.
ALLOW_EXTERNAL_API_CALLS=false
ALLOW_PAID_GENERATION=false
ALLOW_PAID_PROVIDER_FALLBACK=false
AUTO_REGENERATE=false

# Protección opcional con autenticación básica. Recomendada si se publica.
STUDIO_ACCESS_KEY=

# Carpeta de proyectos. En Windows puedes usar C:\ViralCineData
VIRALCINE_DATA_DIR=.data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# OpenAI: guion estructurado, personajes, imágenes y voz.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Puerta de calidad por escena: off | strict
SCENE_QUALITY_MODE=strict
# critical-only continúa automáticamente con defectos menores y pausa únicamente
# ante un fallo grave. strict conserva la aprobación manual para toda nota baja.
SCENE_QUALITY_POLICY=critical-only
OPENAI_QUALITY_MODEL=gpt-5.6
SCENE_QUALITY_MIN_SCORE=8.0
# Una sola generación. Una nota baja no provoca otra llamada de video.
SCENE_QUALITY_MAX_ATTEMPTS=1

# Video real por tomas. No se cambia de proveedor automáticamente salvo que
# ALLOW_PAID_PROVIDER_FALLBACK=true y el límite de generaciones lo permita.
# Valores: auto | omni | veo | fal
VIDEO_PROVIDER=veo
REQUIRE_VIDEO_ONLY=true
ALLOW_FAL_AVATAR_FALLBACK=false
FAL_AVATAR_ONLY_SINGLE_SUBJECT=true
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_OMNI_VIDEO_MODEL=gemini-omni-flash-preview
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p

# Fal.ai: video alternativo, avatares, música y efectos.
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/vidu/q3/image-to-video
FAL_AVATAR_MODEL=fal-ai/longcat-single-avatar/image-audio-to-video
FAL_MUSIC_MODEL=cassetteai/music-generator

# Costos orientativos editables (USD). Se usan para el presupuesto preventivo.
COST_AI_VIDEO_SECOND=0.10
# Compatibilidad con instalaciones 2.x; se usa solo si falta COST_AI_VIDEO_SECOND.
COST_AI_VIDEO_8S=1.23
COST_AVATAR_SECOND=0.30
COST_IMAGE=0.08
COST_TTS_1K_CHARS=0.015
COST_QUALITY_REVIEW=0.03

# Cortafuegos de gasto. Cada llamada se reserva antes de enviarse al proveedor.
SHOT_MAX_TOTAL_GENERATIONS=1
MAX_SHOT_SPEND_USD=2
MAX_MOVIE_SPEND_USD=12

# No reutilizar checkpoints antiguos que podrian venir de demo o de video invalido.
ALLOW_LEGACY_CHECKPOINTS=false

# Rechazar negro, congelado o dialogo inaudible antes de la auditoria de calidad.
BLACK_FRAME_MAX_RATIO=0.35
FREEZE_FRAME_MAX_RATIO=0.60
MIN_DIALOGUE_MEAN_DB=-48

# Máximo de escenas generativas costosas al mismo tiempo.
PRODUCTION_CONCURRENCY=1
